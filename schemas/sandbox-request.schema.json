{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonmap.net/schemas/sandbox-request.schema.json",
  "title": "Approved sandbox provisioning request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "approval",
    "action",
    "task",
    "identity",
    "project",
    "network",
    "data",
    "gke",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]{6,64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_id",
        "approved_at"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "approval_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "action": {
      "const": "CREATE"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "expires_on"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,19}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "expires_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_email",
        "members"
      ],
      "properties": {
        "group_email": {
          "type": "string",
          "pattern": "^pgrp-gcp-dev-[a-z0-9-]+@sonmap\\.net$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._%+-]+@sonmap\\.net$"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "folder_id",
        "billing_account"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "project_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "folder_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "billing_account": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "host_project_id",
        "network_name",
        "region",
        "shared_vpc_join"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "host_project_id": {
          "const": "pjt-d-shared-base"
        },
        "network_name": {
          "const": "vpc-d-shared-base"
        },
        "region": {
          "const": "asia-northeast3"
        },
        "shared_vpc_join": {
          "type": "boolean"
        },
        "subnet_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "subnet_cidr": {
          "type": [
            "string",
            "null"
          ]
        },
        "private_google_access": {
          "type": "boolean",
          "default": true
        },
        "create_subnet": {
          "type": "boolean",
          "default": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "required": [
              "subnet_name",
              "subnet_cidr"
            ],
            "properties": {
              "subnet_name": {
                "type": "string",
                "minLength": 3
              },
              "subnet_cidr": {
                "type": "string",
                "pattern": "^[0-9.]+/24$"
              }
            }
          },
          "else": {
            "properties": {
              "shared_vpc_join": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bigquery_dataset",
        "gcs_bucket"
      ],
      "properties": {
        "bigquery_dataset": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$"
        },
        "gcs_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
        },
        "adopt_existing_resources": {
          "type": "boolean",
          "default": false,
          "description": "Adopt the approved pre-existing Jupyter service account and BigQuery dataset into Infrastructure Manager state."
        }
      }
    },
    "gke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "cluster_name",
        "location",
        "namespace",
        "jupyter_domain"
      ],
      "properties": {
        "project_id": {
          "const": "pjt-d-host01"
        },
        "cluster_name": {
          "const": "gke-sbx-main-an3"
        },
        "location": {
          "const": "asia-northeast3"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,19}$"
        },
        "jupyter_domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.sonmap\\.net$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha"
      ],
      "properties": {
        "repository": {
          "const": "sonmap/Gcp_Managed_GKE_GIT_ETC_09"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
